Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(\.env|composer\.(json|lock)|artisan|phpunit\.xml|phpstan\.neon|VERSION|CHANGELOG\.md|README\.md|SECURITY\.md|LICENSE)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|content|data|resources|routes|scripts|storage|tests|vendor)(/|$) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
